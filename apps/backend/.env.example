# PostgreSQL connection (matches infra/compose/docker-compose.yml)
DATABASE_URL="postgresql://icu:icu_password@localhost:5432/icu_monitoring?schema=public"

# JWT
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Server
PORT=3000
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN="http://localhost:5173"

# Shared secret the ML pipeline uses to push predictions to /predictions/sync
INGEST_API_KEY="ml-pipeline-ingest-key-change-me"

# Realtime vitals simulator (built-in "no Kafka needed" mode).
# Set SIMULATOR_ENABLED=false when feeding data from the real Spark/Kafka pipeline.
SIMULATOR_ENABLED="true"
SIMULATOR_INTERVAL_MS="8000"
